{
  "expo": {
    "name": "VYLTA",
    "slug": "vylta",
    "version": "1.0.6",
    "orientation": "portrait",
    "icon": "./assets/images/app-icon-hkt.png",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/images/app-icon-hkt.png",
      "resizeMode": "contain",
      "backgroundColor": "#000000"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "lat.vylta.app",
      "buildNumber": "7",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false,
        "NSCameraUsageDescription": "VYLTA usa la cámara para que puedas tomar la foto del logo de tu negocio.",
        "NSPhotoLibraryUsageDescription": "VYLTA accede a tus fotos para que puedas seleccionar el logo de tu negocio.",
        "NSContactsUsageDescription": "VYLTA accede a tus contactos para que puedas agregar rápidamente clientes desde tu agenda telefónica."
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/app-icon-hkt.png",
        "backgroundColor": "#000000"
      },
      "edgeToEdgeEnabled": true,
      "package": "lat.vylta.app",
      "versionCode": 25,
      "googleServicesFile": "./google-services.json",
      "permissions": [
        "android.permission.INTERNET",
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE",
        "android.permission.RECEIVE_BOOT_COMPLETED",
        "android.permission.VIBRATE"
      ]
    },
    "web": {
      "favicon": "./assets/images/final_quest_240x240.png",
      "bundler": "metro"
    },
    "plugins": [
      "expo-font",
      "expo-router",
      "expo-web-browser",
      [
        "expo-notifications",
        {
          "icon": "./assets/images/app-icon-hkt.png",
          "color": "#10B981",
          "defaultChannel": "default"
        }
      ]
    ],
    "scheme": "vylta",
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "a924a46c-7b9c-42b8-bbdb-aa0e063c4ff7"
      }
    },
    "owner": "tonybravo001",
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "url": "https://u.expo.dev/a924a46c-7b9c-42b8-bbdb-aa0e063c4ff7"
    }
  }
}
